                                                <th style={{ padding: "10px 8px", textAlign: "left" }}>Posologie</th>
                                                <th style={{ padding: "10px 8px", textAlign: "left" }}>Fréquence</th>
                                                <th style={{ padding: "10px 8px", textAlign: "left" }}>Durée</th>
