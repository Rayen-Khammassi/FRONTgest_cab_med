    gap: 5px;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #0f172a !important;
    border: 1px solid #020617 !important;
    color: #ffffff !important;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(15, 23, 42, 0.2);
    transition: all 0.15s ease;
    white-space: nowrap;
}

.med-btn-edit:hover:not(:disabled) {
    background: #1e293b !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.3);
}

.med-btn-delete {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #991b1b !important;
    border: 1px solid #7f1d1d !important;
    color: #ffffff !important;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(153, 27, 27, 0.25);
    transition: all 0.15s ease;
    white-space: nowrap;
}

.med-btn-delete:hover:not(:disabled) {
    background: #7f1d1d !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(127, 29, 29, 0.45);
}

.med-btn-edit:disabled,
.med-btn-delete:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none !important;
}

/* ── Alerte notification ── */
.med-alerte {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 14px;
    margin-bottom: 22px;
    font-size: 0.92rem;
    font-weight: 600;
    animation: alerteGlisse 0.25s ease;
}

@keyframes alerteGlisse {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

.med-alerte-succes {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
}

.med-alerte-erreur {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
}

.med-alerte-icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
}

.med-alerte-texte {
    flex: 1;
}

.med-alerte-fermer {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    opacity: 0.7;
    display: grid;
    place-items: center;
    transition: opacity 0.15s ease;
}

.med-alerte-fermer:hover {
    opacity: 1;
}

/* Animation rotation pour le rechargement */
.animation-rotation {
    animation: rotationInfini 1s linear infinite;
}

@keyframes rotationInfini {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
