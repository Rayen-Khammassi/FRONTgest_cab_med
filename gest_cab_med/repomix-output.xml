/* FLOATING TOAST NOTIFICATION COMPONENT (Uiverse-inspired glassmorphism) */
.notification-toast {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: 9999px;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 16px 40px rgba(18, 63, 89, 0.18), 0 2px 10px rgba(8, 127, 158, 0.1);
    animation: toastSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    font-size: 0.91rem;
    font-weight: 600;
    max-width: 480px;
}

@keyframes toastSlideIn {
    from {
        opacity: 0;
        transform: translateY(-16px) scale(0.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.toast-icon-wrap {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
}

.toast-success {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(22, 196, 170, 0.4);
    color: #0b685a;
}
.toast-success .toast-icon-wrap {
    background: rgba(22, 196, 170, 0.16);
    color: #16c4aa;
}

.toast-error {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #991b1b;
}
.toast-error .toast-icon-wrap {
    background: rgba(239, 68, 68, 0.16);
    color: #ef4444;
}

.toast-info {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(8, 127, 158, 0.4);
    color: #087f9e;
}
