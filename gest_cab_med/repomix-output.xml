                            <div className="form-champ">
                                <label>Consultation de référence</label>
                                <select
                                    value={prescriptionForm.idConsultation}
                                    onChange={(e) => setPrescriptionForm({ ...prescriptionForm, idConsultation: e.target.value })}
                                    required
                                >
