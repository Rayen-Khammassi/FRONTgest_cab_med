import { useEffect, useState } from "react";
import "./Login.css";
import { useNavigate } from "react-router-dom";
import { loginUser, saveUser } from "../services/authService";
import { LogoAlZahraoui } from "../components/MedicalIcons";

function Login() {
    const [introFinished, setIntroFinished] = useState(false);
    const [mode, setMode] = useState("LOGIN");
    const [isLoading, setIsLoading] = useState(false);
    const navigate = useNavigate();
    const [login, setLogin] = useState("");
    const [password, setPassword] = useState("");

    const [nom, setNom] = useState("");
    const [prenom, setPrenom] = useState("");
    const [email, setEmail] = useState("");
    const [dateNaissance, setDateNaissance] = useState("");
    const [adresse, setAdresse] = useState("");

    const [feedback, setFeedback] = useState({
        type: "",
        message: "",
    });

    useEffect(() => {
        const timer = setTimeout(() => {
            setIntroFinished(true);
        }, 150);

        return () => clearTimeout(timer);
    }, []);

    const changeMode = (newMode) => {
        setMode(newMode);
        setFeedback({ type: "", message: "" });
    };

    const handleSubmit = async (event) => {
        event.preventDefault();

        if (isLoading) return;

        setIsLoading(true);
        setFeedback({ type: "", message: "" });

        try {
            if (mode === "LOGIN") {

                const data = await loginUser(login, password);

                // Save authenticated user
                saveUser(data);

                // Redirect according to the role
                const routes = {
                    PATIENT: "/patient",
                    DOCTEUR: "/doctor",
                    SECRETAIRE: "/secretary",
                };

                const destination = routes[data.role];

                if (!destination) {
                    throw new Error("Rôle utilisateur non reconnu.");
                }

                navigate(destination, { replace: true });

            } else {
                const apiBase = (
                    import.meta.env.VITE_MAIN_API_URL || "http://localhost:8081"
                ).replace(/\/$/, "");

                const response = await fetch(
                    `${apiBase}/api/auth/register`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            nom,
                            prenom,
                            email,
                            login,
                            password,
                            dateNaissance,
                            adresse,
                        }),
                    }
                );

                const data = await response.json();

                if (!response.ok) {
                    setFeedback({
                        type: "error",
                        message: data.message || "Erreur lors de l'inscription.",
                    });
                    return;
                }

                setFeedback({
                    type: "success",
                    message: "Compte créé avec succès ! Vous pouvez maintenant vous connecter.",
                });

                setNom("");
                setPrenom("");
                setEmail("");
                setLogin("");
                setPassword("");
                setDateNaissance("");
                setAdresse("");

                setMode("LOGIN");
            }

        } catch (error) {
            setFeedback({
                type: "error",
                message: error.message || "Impossible de contacter le serveur.",
            });

        } finally {
            setIsLoading(false);
        }
    };

    return (
        <main className={`auth-page ${introFinished ? "intro-finished" : ""}`}>

            {/* Background decoration */}
            <div className="background-glow glow-one" />
            <div className="background-glow glow-two" />
            <div className="background-glow glow-three" />

            <div className="medical-scene" aria-hidden="true">
                <span className="medical-decoration decoration-heart">♥</span>
                <span className="medical-decoration decoration-cross">✚</span>
                <span className="medical-decoration decoration-pill">✚</span>
                <span className="medical-decoration decoration-shield">♡</span>
                <span className="medical-decoration decoration-capsule">✚</span>
                <span className="medical-decoration decoration-cross-two">✚</span>
                <span className="medical-orb orb-one" />
                <span className="medical-orb orb-two" />
            </div>

            {/* Main content */}
            <div className="auth-content">

                <header className="brand">
                    <div className="brand-logo-pure" aria-label="Logo Al-Zahraoui">
                        <LogoAlZahraoui size={78} />
                    </div>
                    <div className="brand-text">
                        <h1 className="brand-title-authentic">Al-Zahraoui</h1>
                        <p className="brand-subtitle-authentic">Cabinet Médical · Système de gestion</p>
                    </div>
                </header>

                <section className={`auth-panel ${introFinished ? "panel-visible" : ""}`}>

                    <div className="panel-heading">
                        <h2>
                            {mode === "LOGIN"
                                ? "Bienvenue"
                                : "Créer un compte"}
                        </h2>

                        <p>
                            {mode === "LOGIN"
                                ? "Connectez-vous à votre espace personnel"
                                : "Rejoignez notre espace patient"}
                        </p>
                    </div>

                    {/* Animated tabs */}
                    <div className={`auth-tabs ${mode === "REGISTER" ? "register-active" : ""}`}>
                        <div className="tab-indicator" />

                        <button
                            type="button"
                            className={mode === "LOGIN" ? "selected" : ""}
                            onClick={() => changeMode("LOGIN")}
                        >
                            Connexion
                        </button>

                        <button
                            type="button"
                            className={mode === "REGISTER" ? "selected" : ""}
                            onClick={() => changeMode("REGISTER")}
                        >
                            Inscription
                        </button>
                    </div>

                    {/* Status feedback */}
                    {feedback.message && (
                        <div
                            className={`feedback-box ${feedback.type === "error" ? "feedback-error" : "feedback-success"
                            }`}
                        >
                            <span className="feedback-bullet">•</span>
                            <span>{feedback.message}</span>
                        </div>
                    )}

                    {/* Authentication Form */}
                    <form onSubmit={handleSubmit} className="auth-form" noValidate>

                        {mode === "REGISTER" && (
                            <>
                                <div className="input-row">
                                    <div className="field-group">
                                        <label htmlFor="nom">Nom</label>
                                        <input
                                            id="nom"
                                            type="text"
                                            value={nom}
                                            onChange={(e) => setNom(e.target.value)}
                                            placeholder="Ex: Ben Ali"
                                            required
                                        />
                                    </div>

                                    <div className="field-group">
                                        <label htmlFor="prenom">Prénom</label>
                                        <input
                                            id="prenom"
                                            type="text"
                                            value={prenom}
                                            onChange={(e) => setPrenom(e.target.value)}
                                            placeholder="Ex: Mohamed"
                                            required
                                        />
                                    </div>
                                </div>

                                <div className="field-group">
                                    <label htmlFor="email">Email</label>
                                    <input
                                        id="email"
                                        type="email"
                                        value={email}
                                        onChange={(e) => setEmail(e.target.value)}
                                        placeholder="votre.email@domaine.tn"
                                        required
                                    />
                                </div>

                                <div className="input-row">
                                    <div className="field-group">
                                        <label htmlFor="dateNaissance">Date de naissance</label>
                                        <input
                                            id="dateNaissance"
                                            type="date"
                                            value={dateNaissance}
                                            onChange={(e) => setDateNaissance(e.target.value)}
                                        />
                                    </div>

                                    <div className="field-group">
                                        <label htmlFor="adresse">Adresse</label>
                                        <input
                                            id="adresse"
                                            type="text"
                                            value={adresse}
                                            onChange={(e) => setAdresse(e.target.value)}
                                            placeholder="Ex: Tunis, Ariana"
                                        />
                                    </div>
                                </div>
                            </>
                        )}

                        <div className="field-group">
                            <label htmlFor="login">Identifiant / Nom d'utilisateur</label>
                            <input
                                id="login"
                                type="text"
                                value={login}
                                onChange={(e) => setLogin(e.target.value)}
                                placeholder="Votre nom d'utilisateur"
                                required
                            />
                        </div>

                        <div className="field-group">
                            <label htmlFor="password">Mot de passe</label>
                            <input
                                id="password"
                                type="password"
                                value={password}
                                onChange={(e) => setPassword(e.target.value)}
                                placeholder="••••••••"
                                required
                            />
                        </div>

                        <button
                            type="submit"
                            className="submit-button"
                            disabled={isLoading}
                        >
                            <span>
                                {isLoading
                                    ? "Traitement..."
                                    : mode === "LOGIN"
                                        ? "Se connecter"
                                        : "Créer mon compte"}
                            </span>
                            <span className="button-arrow" aria-hidden="true">→</span>
                        </button>
                    </form>

                    <footer className="panel-footer">
                        <p>
                            Al-Zahraoui · Système médical sécurisé · Conforme RGPD santé
                        </p>
                    </footer>
                </section>
            </div>
        </main>
    );
}

export default Login;
</file>

<file path="src/pages/MedicamentPage.css">
/* =================================================================
   AL-ZAHRAOUI — MODULE MÉDICAMENTS & PHARMACIE
   Thème médical premium harmonisé avec DashboardLayout & App.css
   ================================================================= */

.medicaments-conteneur {
    width: 100%;
    margin-top: 6px;
    box-sizing: border-box;
}

/* ── Grille principale 2 colonnes ── */
.medicaments-grille {
    display: grid;
    grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
    gap: 24px;
    align-items: flex-start;
    width: 100%;
    box-sizing: border-box;
}

@media (max-width: 1220px) {
    .medicaments-grille {
        grid-template-columns: 1fr;
        gap: 24px;
    }
}

/* ── Cartes blanches avec ombre douce & bordure nette ── */
.medicaments-carte {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: 26px 24px;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.06), 0 4px 12px -2px rgba(15, 23, 42, 0.03);
    color: #0f172a;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
}

.medicaments-carte:hover {
    box-shadow: 0 16px 36px -6px rgba(15, 23, 42, 0.09), 0 6px 14px -3px rgba(15, 23, 42, 0.04);
}

/* ── En-tête de carte avec icône badge ── */
.medicaments-carte-en-tete {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f1f5f9;
}

.medicaments-badge-icone {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 14px;
    background: #f0fdfa;
    border: 1px solid #ccfbf1;
    color: #0f766e;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgba(15, 118, 110, 0.08);
}

.medicaments-carte-titre {
    margin: 0 0 5px 0;
    font-size: 1.28rem;
    font-weight: 750;
    color: #0f172a;
    letter-spacing: -0.015em;
    line-height: 1.25;
}

.medicaments-carte-sous-titre {
    margin: 0;
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.45;
}

/* ── Formulaire d'ajout / modification ── */
.medicaments-formulaire {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.medicaments-formulaire .form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0;
}

.medicaments-formulaire .form-label {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: 0.01em;
}

.medicaments-formulaire .form-control {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border-radius: 12px;
    border: 1.5px solid #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
    font-size: 0.92rem;
    font-weight: 500;
    outline: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.medicaments-formulaire .form-control::placeholder {
    color: #94a3b8;
}

.medicaments-formulaire .form-control:hover {
    border-color: #94a3b8;
    background: #ffffff;
}

