/* =================================================================
   11. VISUAL REFINEMENT & DESIGN SYSTEM POLISH
   ================================================================= */

/* 1. Unitalicize random words */
* {
    font-style: normal;
}

/* 2. Headline Wrapping & Modern Typography (Plus Jakarta Sans) */
h1, h2, h3, h4, h5, h6,
.section-title,
.banner-label,
.modal-header h3 {
    font-family: var(--font-display);
    text-wrap: balance;
    letter-spacing: -0.02em;
    font-weight: 700;
}

/* 3. Mono font ONLY where strictly needed (IDs, codes, hashes) */
.font-mono,
code,
pre,
.cell-id,
.badge-id {
    font-family: var(--font-mono) !important;
    font-size: 0.82em;
    letter-spacing: -0.02em;
}

/* 4. Tabular Numbers for all financial, calendar, quantity and date numbers */
.font-tabular,
table td,
table th,
.badge-status,
.ordonnance-meta,
.stat-number,
input[type="number"],
input[type="date"],
input[type="datetime-local"] {
    font-variant-numeric: tabular-nums lining-nums;
}

/* 5. Inner Radius = Outer Radius - Padding */
/* Outer containers have 24px radius, 16px/24px padding -> inner elements have 8px-12px */
.medicaments-panneau {
    border-radius: var(--radius-outer);
    padding: 24px;
}

.medicaments-panneau .table-responsive,
.medicaments-panneau table {
    border-radius: calc(var(--radius-outer) - 12px);
    overflow: hidden;
}

.modal-glass {
    border-radius: var(--radius-outer);
    padding: 24px;
}

.modal-glass .form-control,
.modal-glass input,
.modal-glass select,
.modal-glass textarea {
    border-radius: calc(var(--radius-outer) - 14px); /* 10px */
}

.ordonnance-card {
    border-radius: var(--radius-outer);
    padding: 24px;
}

.service-card {
    border-radius: 20px;
    padding: 20px;
}

.service-card .service-icon {
    border-radius: 12px;
}

/* 6. Optical Alignment for Icons & Labels (Align by eye, not pure pixels) */
.btn-action-principal,
.btn-retour,
.med-btn,
.badge-status,
.sidebar-link {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
}

/* 7. Enhanced CTA Hierarchy (Emphasize the primary action) */
.btn-action-principal {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);
    color: #ffffff;
    font-weight: 650;
    box-shadow: var(--shadow-cta);
    border: none;
    border-radius: 12px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
}

.btn-action-principal:hover:not(:disabled) {
    transform: translateY(-1.5px);
    box-shadow: 0 14px 30px rgba(2, 132, 199, 0.45);
}

.btn-action-principal:active:not(:disabled) {
    transform: scale(0.97) !important;
    transition: none !important;
}

/* 8. Text Contrast Improvements (Readable shades) */
.text-high-contrast {
    color: var(--text-primary) !important;
}

.text-muted {
    color: var(--text-muted) !important;
}

/* 9. Loading and Skeleton States */
button:disabled {
    opacity: 0.65;
    cursor: not-allowed !important;
    transform: none !important;
}

.loading-spinner {
    width: 24px;
    height: 24px;
    border: 3px solid rgba(8, 127, 158, 0.18);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spinnerRotate 0.75s linear infinite;
    display: inline-block;
}

@keyframes spinnerRotate {
    to { transform: rotate(360deg); }
}

/* 10. Success Confirmation Pulse */
@keyframes successPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.04); box-shadow: 0 0 16px rgba(19, 189, 169, 0.4); }
    100% { transform: scale(1); }
}

.pulse-success {
    animation: successPulse 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}



/* =================================================================
   CONFIRMATION MODAL (FRENCH POP-UP "ANNULER / ACCEPTER")
   ================================================================= */
.confirm-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 20px;
    animation: confirmFadeIn 0.18s ease-out both;
}

@keyframes confirmFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.confirm-modal-glass {
    background: #ffffff;
    color: #0f172a;
    width: 100%;
    max-width: 480px;
    border-radius: 20px;
    padding: 28px 24px 22px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(15, 23, 42, 0.08);
    transform-origin: center;
    animation: confirmScaleIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes confirmScaleIn {
    from { transform: scale(0.94) translateY(8px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
}

.confirm-modal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
